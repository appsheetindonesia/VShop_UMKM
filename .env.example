[TEMPLATE]
# ===== V Shop — Environment Example =====
# Salin ke `.env.local` lalu isi sesuai kebutuhan. Semua opsional:
# tanpa kredensial, aplikasi berjalan dalam mode demo (pembayaran simulasi).
# Untuk Supabase LOKAL, cukup jalankan:  npm run db:setup
# (script setup-local.mjs otomatis menulis .env.local + seed).

# --- App ---
APP_URL=http://localhost:3000        # dipakai untuk link di notifikasi WhatsApp
CRON_SECRET=                          # proteksi /api/cron/* (Vercel Cron + curl lokal)

# --- Supabase (Auth + PostgreSQL + RLS + Storage) ---
# Aktif otomatis saat NEXT_PUBLIC_SUPABASE_URL terisi; tanpa itu memakai db.json demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # HANYA di server (bukan NEXT_PUBLIC_)
# Masuk/daftar pelanggan via OTP WhatsApp (Supabase Auth phone):
#   - aktifkan provider Phone + SMS di dashboard (Authentication → Sign In/Up
#     → Phone & SMS) + kanal WhatsApp/SMS untuk OTP
#   - lokal (supabase start): OTP diuji via [auth.sms.test_otp] di config.toml
#   - fallback password tetap tersedia (tab Password di halaman masuk/daftar)
# Enkripsi refresh token di tabel sessions (migration 0002) — pemulihan sesi
# lintas perangkat tanpa cookie. Generate: `openssl rand -base64 32`.
# Tanpa key: aplikasi tetap jalan (fallback cookie-only).
SESSION_ENCRYPTION_KEY=

# --- Midtrans (sandbox default; aktif otomatis saat server key diisi) ---
# Daftar di https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Tanpa key: pembayaran disimulasikan (mode demo).
MIDTRANS_SERVER_KEY=                  # HANYA di server
MIDTRANS_CLIENT_KEY=                  # publik — dipakai Snap.js embed di halaman bayar
MIDTRANS_IS_PRODUCTION=false          # true HANYA untuk transaksi nyata
# Override base URL Snap v1 & Status v2 (pengujian lokal / proxy):
# MIDTRANS_API_BASE=https://api.sandbox.midtrans.com/v2
# Override URL Snap.js yang dimuat browser (uji jalur embed dengan stub lokal):
# MIDTRANS_SNAP_SCRIPT_URL=http://localhost:53130/snap.js

# --- WhatsApp notifikasi (Cloud API Meta; aktif otomatis saat token diisi) ---
# Daftar di https://developers.facebook.com → WhatsApp → API Setup:
#   WHATSAPP_TOKEN (system user / permanent token)
#   WHATSAPP_PHONE_NUMBER_ID (dari nomor bisnis terverifikasi)
# Nomor tujuan memakai E.164 tanpa "+" (mis. 6281234567890) — diambil dari
# akun pelanggan (phone) atau merchant (noWAUsaha). Tanpa token: mode demo
# (notifikasi dicatat di log server dengan prefix [wa]).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TO=                 # opsional — tujuan pesanan baru (default: noWAUsaha merchant)
WHATSAPP_SUPPORT_NUMBER=              # opsional — nomor support (tombol 'Lacak Pesanan' → wa.me) di detail transaksi gagal
WA_LINK_BASE=                         # opsional — domain PUBLIK untuk link di pesan WA, terpisah dari APP_URL (mis. https://wa.vshop.id)
# WHATSAPP_API_BASE=https://graph.facebook.com/v20.0   # override untuk pengujian
#
# --- Template message (mode kirim UTAMA) ---
# WHATSAPP_MESSAGE_MODE: auto = template Meta (utama) + fallback teks bebas;
#   text = selalu teks bebas (sandbox/uji tanpa template disetujui).
WHATSAPP_MESSAGE_MODE=auto
# Nama template yang SUDAH DISETUJUI Meta per jenis notifikasi + bahasa.
# Body template memakai placeholder {{1}}..{{n}} yang diisi urut (lihat
# README → "Notifikasi WhatsApp" untuk contoh body per template).
WHATSAPP_TEMPLATE_PAID=
WHATSAPP_TEMPLATE_FAILED=
WHATSAPP_TEMPLATE_ORDER=
WHATSAPP_TEMPLATE_REDEEMED=          # voucher diredeem → merchant (alur getken)
WHATSAPP_TEMPLATE_EXPIRING=          # voucher hampir kadaluarsa → pelanggan (cron 48 jam & H-1)
WHATSAPP_TEMPLATE_RETRIED=           # order siap dibayar ulang (admin retry massal → pelanggan)
WHATSAPP_TEMPLATE_DAILY_SUMMARY=     # ringkasan harian merchant (cron harian → merchant)
WHATSAPP_TEMPLATE_LANG=id
# Tombol (component `button`) pada template paid/failed — daftar peran dipisah
# koma, URUT sesuai indeks tombol di template Meta. Peran: detail (url →
# <APP_URL>/transaksi/{{1}}), retry (url → <APP_URL>/bayar/{{1}}), dashboard
# (url tetap → <APP_URL>/merchant/dashboard), vouchers (url tetap →
# <APP_URL>/voucher-saya). Kosong = template body-only.
WHATSAPP_TEMPLATE_PAID_BUTTONS=
WHATSAPP_TEMPLATE_FAILED_BUTTONS=retry,detail   # mis. "Bayar ulang" + "Lihat detail pesanan"
WHATSAPP_TEMPLATE_EXPIRING_BUTTONS=vouchers     # CTA "Gunakan Sekarang" → <APP_URL>/voucher-saya (url tetap)
# Notifikasi "voucher hampir kadaluarsa" dikirim N jam sebelum masa berlaku habis
# (dieksekusi cron /api/cron/expire-orders; dedupe per klaim via expiring_notified_at).
VOUCHER_EXPIRY_NOTIFY_HOURS=48
# Tier kedua: pengingat H-1 — dikirim N jam sebelum masa berlaku habis lewat
# cron /api/cron/voucher-expiring-24h (vercel.json + interval lokal). Dedupe
# independen via expiring_24h_notified_at, tidak terblokir oleh tier 48 jam.
VOUCHER_EXPIRY_24H_NOTIFY_HOURS=24
#
# --- Antrian kirim in-memory + retry backoff ---
# Semua notifikasi masuk antrian latar belakang (konkurrensi terbatas) agar
# request pembayaran tidak menunggu puluhan kiriman. Kegagalan sementara
# (network / HTTP 5xx / 429 / tanpa message id) diulang otomatis dengan
# exponential backoff + jitter. Default di bawah cukup untuk produksi;
# kecilkan hanya untuk pengujian lokal yang cepat.
# WA_QUEUE_CONCURRENCY=3             # maks kiriman diproses paralel
# WA_RETRY_MAX_ATTEMPTS=3            # percobaan utk kegagalan sementara
# WA_RETRY_BASE_MS=800               # backoff awal; eksponensial ×2, cap 8s, +jitter
# Retry cron notifikasi gagal (status=failed di notification_logs; migration 0011):
# NOTIF_RETRY_MAX_ATTEMPTS=3          # backoff TERBATAS: maks percobaan ulang per entri
# NOTIF_RETRY_BACKOFF_MS=1800000      # jarak antar percobaan ulang entri yg sama (30 mnt)
# NOTIF_RETRY_MIN_AGE_MS=300000       # umur min entri gagal sebelum layak di-retry (5 mnt)
# NOTIF_RETRY_BATCH=10                # maks entri diproses per run cron (anti-burst)
#
# --- Scheduler lokal (jitter + backoff gagal) ---
# Interval scheduler di-root layout memakai jitter ±20% per tick (mencegah
# beberapa job/instance memicu di menit yang sama) dan backoff LEBIH CEPAT
# saat run gagal beruntun (eksponensial, dibatasi interval normal).
# CRON_SCHEDULER_JITTER=0.2          # 0–1 (0 = interval tetap)
# CRON_FAILURE_BACKOFF_MS=300000     # base backoff saat gagal (×2 per kegagalan)

# --- Write-through & drain shutdown (db.ts) ---
# Batas waktu flush paksa (flushNow / drain terakhir saat SIGTERM/SIGINT):
# snapshot terbaru yang masih mengantre di persistChain ikut ter-flush
# sebelum proses keluar, tapi tidak pernah menunggu lebih lama dari ini.
# DB_FLUSH_MAX_WAIT_MS=5000
#
# KNOB OBSERVABILITY — JANGAN UNTUK PRODUKSI. DB_COALESCE=0 mematikan
# penggabungan batch di persistChain: setiap mutate() langsung me-flush
# koleksi dirty-nya sendiri (batch dikunci, tulis lama tidak di-dedupe).
# Dipakai scripts/measure-writes.test.ts sebagai pembanding "sebelum
# koalesensi" (tiap mutate = 1+ tulis nyata ke Supabase). Efeknya pada
# volume tulis: alur bayar sukses 2 → 3 tulis, topup 3 → 4, merchandise
# 4 → 5 (lihat README → "Pengukuran tulis ke Supabase"). Hanya untuk
# mengukur/mendebug; di produksi KOALESENSI HARUS AKTIF (biarkan kosong).
# DB_COALESCE=0
#
# KNOB OBSERVABILITY (mode demo saja) — JSON_DEBOUNCE=0 mematikan debounce
# tulis file data/db.json: setiap mutate() menulis LANGSUNG (tanpa menunggu
# akhir tick). Dipakai scripts/measure-json-writes.test.ts sebagai pembanding
# "sebelum debounce" (tulis per tick dihitung via getJsonWriteCount). Efek:
# bayar sukses 1 → 2 tulis (2 mutate 1 tick digabung jadi 1). Hanya untuk
# mengukur/mendebug mode demo; biarkan kosong di produksi.
# JSON_DEBOUNCE=0

# --- Auto-expire order ---
# Order pending yang melewati batas ini di-expire (cron / scheduler lokal),
# konsisten dengan field expiry transaksi Midtrans.
ORDER_EXPIRY_HOURS=24
# Untuk menguji batas waktu dengan cepat, jalankan dev server dengan nilai
# kecil, mis. ORDER_EXPIRY_HOURS=0.01 (= 36 detik) — order berumur >36 detik
# akan di-expire pada cron berikutnya.

# --- Batas retry pembayaran ---
# Maksimal percobaan "Coba Lagi" per order (guard di service + UI). Order
# yang gagal terus-menerus tidak bisa di-retry tanpa batas.
MAX_ORDER_RETRIES=3
