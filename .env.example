# ===== V Shop — Environment Example =====
# Salin ke `.env.local` lalu isi sesuai kebutuhan. Semua opsional:
# tanpa kredensial, aplikasi berjalan dalam mode demo (pembayaran simulasi).
# Untuk Supabase LOKAL, cukup jalankan:  npm run db:setup
# (script setup-local.mjs otomatis menulis .env.local + seed).

# --- App ---
APP_URL=http://localhost:3000        # dipakai untuk link di notifikasi WhatsApp
CRON_SECRET=                          # proteksi /api/cron/expire-orders (Vercel Cron)

# --- Supabase (Auth + PostgreSQL + RLS + Storage) ---
# Aktif otomatis saat NEXT_PUBLIC_SUPABASE_URL terisi; tanpa itu memakai db.json demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # HANYA di server (bukan NEXT_PUBLIC_)
# Masuk/daftar pelanggan via OTP WhatsApp (Supabase Auth phone):
#   - aktifkan provider Phone + SMS di dashboard (Authentication → Sign In/Up
#     → Phone & SMS) + kanal WhatsApp/SMS untuk OTP
#   - lokal (supabase start): OTP diuji via [auth.sms.test_otp] di config.toml
#   - fallback password tetap tersedia (tab Password di halaman masuk/daftar)
# Enkripsi refresh token di tabel sessions (migration 0002) — pemulihan sesi
# lintas perangkat tanpa cookie. Generate: `openssl rand -base64 32`.
# Tanpa key: aplikasi tetap jalan (fallback cookie-only).
SESSION_ENCRYPTION_KEY=

# --- Midtrans (sandbox default; aktif otomatis saat server key diisi) ---
# Daftar di https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Tanpa key: pembayaran disimulasikan (mode demo).
MIDTRANS_SERVER_KEY=                  # HANYA di server
MIDTRANS_CLIENT_KEY=                  # publik — dipakai Snap.js embed di halaman bayar
MIDTRANS_IS_PRODUCTION=false          # true HANYA untuk transaksi nyata
# Override base URL Snap v1 & Status v2 (pengujian lokal / proxy):
# MIDTRANS_API_BASE=https://api.sandbox.midtrans.com/v2
# Override URL Snap.js yang dimuat browser (uji jalur embed dengan stub lokal):
# MIDTRANS_SNAP_SCRIPT_URL=http://localhost:53130/snap.js

# --- WhatsApp notifikasi (Cloud API Meta; aktif otomatis saat token diisi) ---
# Daftar di https://developers.facebook.com → WhatsApp → API Setup:
#   WHATSAPP_TOKEN (system user / permanent token)
#   WHATSAPP_PHONE_NUMBER_ID (dari nomor bisnis terverifikasi)
# Nomor tujuan memakai E.164 tanpa "+" (mis. 6281234567890) — diambil dari
# akun pelanggan (phone) atau merchant (noWAUsaha). Tanpa token: mode demo
# (notifikasi dicatat di log server dengan prefix [wa]).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TO=                 # opsional — tujuan pesanan baru (default: noWAUsaha merchant)
# WHATSAPP_API_BASE=https://graph.facebook.com/v20.0   # override untuk pengujian

# --- Auto-expire order ---
# Order pending yang melewati batas ini di-expire (cron / scheduler lokal),
# konsisten dengan field expiry transaksi Midtrans.
ORDER_EXPIRY_HOURS=24
