{
  "name": "vshop",
  "version": "1.0.0",
  "private": true,
  "description": "V SHOP — Pusat Voucher Belanja. Platform voucher & promo berbasis Next.js + TypeScript + Tailwind.",
  "scripts": {
    "dev": "next dev",
    "stop:dev": "node scripts/stop-dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:persist-chain": "vitest run scripts/persist-chain.test.ts",
    "test:measure-writes": "vitest run scripts/measure-writes.test.ts",
    "test:measure-json-writes": "vitest run scripts/measure-json-writes.test.ts",
    "test:e2e-retry": "vitest run scripts/e2e-retry.test.ts",
    "test:e2e-sim": "vitest run scripts/e2e-sim-flows.test.ts",
    "db:setup": "node scripts/setup-local.mjs",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:seed": "node scripts/seed-supabase.mjs",
    "db:status": "npx supabase status",
    "db:rls": "node scripts/e2e-rls.mjs",
    "db:webhook": "node scripts/e2e-webhook.mjs",
    "db:snap-error": "node scripts/e2e-snap-error.mjs",
    "webhook:ngrok": "node scripts/ngrok-webhook.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "^4.1.10"
  }
}
